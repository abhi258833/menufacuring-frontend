
import { siteConfig } from "../data/data";
import axios from "axios";


const authToken = localStorage.getItem("authToken") || "";
const csrfToken = localStorage.getItem("csrfToken") || "";

// Sort mapping for DSpace API compatibility
const SORT_API_VALUES: Record<string, string> = {
  'relevant': 'score,DESC',
  'title-asc': 'dc.title,ASC',
  'title-desc': 'dc.title,DESC',
  'accessioned-asc': 'dc.date.accessioned,ASC',
  'accessioned-desc': 'dc.date.accessioned,DESC',
  'lastModified': 'dc.date.modified,DESC',
};

const getSortApiValue = (sortValue: string): string => {
  return SORT_API_VALUES[sortValue] || 'score,DESC';
};

const buildWorkflowTaskQueryParams = (params: WorkflowTaskSearchParams): string => {
  const queryParams = new URLSearchParams();
  queryParams.append('configuration', 'workflow');

  if (params.sort) {
    const apiSortValue = getSortApiValue(params.sort);
    queryParams.append('sort', apiSortValue);
  } else {
    queryParams.append('sort', 'score,DESC');
  }

  queryParams.append('page', (params.page || 0).toString());
  queryParams.append('size', (params.size || 10).toString());

  if (params.filters) {
    Object.entries(params.filters).forEach(([key, value]) => {
      if (!value) return;

      if (Array.isArray(value)) {
        value.forEach(val => {
          if (key === 'date' && val.includes(' - ')) {
            const dateRange = `[${val.split(' - ')[0]} TO ${val.split(' - ')[1]}]`;
            queryParams.append('f.dateIssued', `${dateRange},equals`);
          } else {
            queryParams.append(`f.${key}`, `${val},equals`);
          }
        });
      }
    });
  }
  return queryParams.toString();
};

export const getWorkflowObjects = async (params: WorkflowTaskSearchParams) => {
  let apiUrl = `${siteConfig.apiEndpoint}/api/discover/search/objects?${buildWorkflowTaskQueryParams(params)}&embed=thumbnail&embed=item/thumbnail&embed=accessStatus`;

  if (params.query?.trim()) {
    apiUrl += `&query=${encodeURIComponent(params.query)}`;
  }

  try {
    const response = await axios.get<any>(apiUrl, {
      headers: {
        "Content-Type": "application/json",
        Authorization: authToken,
      },
      withCredentials: true,
    });
    const objects = response.data._embedded?.searchResult?._embedded?.objects || [];
    console.log('[Workflow] Full API Response:', response.data);
    console.log('[Workflow] Objects:', objects);
    if (objects.length > 0) {
      console.log('[Workflow] First object structure:', objects[0]);
    }
    return {
      objects: objects,
      totalElements: response.data._embedded?.searchResult?.page?.totalElements || 0
    }
  } catch (error: any) {
    const errorStatus = error.response?.status || 500;
    if (errorStatus === 400) {
      window.location.href = `/error-400`;
    } else if (errorStatus === 401) {
      window.location.href = `/error-401`;
    } else if (errorStatus === 403) {
      window.location.href = `/error-403`;
    } else if (errorStatus === 422) {
      window.location.href = `/error-422`;
    } else if (errorStatus === 500) {
      window.location.href = `/error-500`;
    } else {
      window.location.href = `/error-404`;
    }
  }
}

export const getWorkflowSubmittersFacet = async (params: WorkflowTaskSearchParams) => {
  let apiUrl = `${siteConfig.apiEndpoint}/api/discover/facets/submitter?${buildWorkflowTaskQueryParams(params)}`;

  if (params.query) {
    apiUrl += `&query=${encodeURIComponent(params.query)}`;
  }

  try {
    const response = await axios.get<any>(apiUrl, {
      headers: {
        "Content-Type": "application/json",
        "X-XSRF-TOKEN": csrfToken,
        Authorization: authToken,
      },
      withCredentials: true,
    });
    return response.data._embedded?.values?.map((value: any) => ({
      id: value.label,
      label: value.label,
      count: value.count
    })) || [];
  } catch (error) {
    console.error('Error fetching submitter facet:', error);
    return [];
  }
};

