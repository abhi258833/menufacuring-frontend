const handleApiError = (error: any) => {
  const errorStatus = error.response?.status || 500;
  const errorData = error.response?.data;
  
  // Log detailed error info
  console.error('[API Error] Status:', errorStatus);
  console.error('[API Error] Data:', errorData);
  console.error('[API Error] Message:', error.message);
};

export const claimedtask = async (id: string) => {
    try {
        console.log('[API claimedtask] Received ID:', id, 'Type:', typeof id);
        
        // Extract numeric ID if it's a UUID or complex format
        let taskId = id;
        if (id && id.includes('-')) {
            // If it's a UUID format, extract just the numeric part or take it as is
            console.log('[API claimedtask] UUID format detected:', id);
        }
        
        const url = `${siteConfig.apiEndpoint}/api/workflow/claimedtasks`;
        // DSpace expects the pool task URI in text/uri-list format
        const body = `${siteConfig.apiEndpoint}/api/workflow/pooltasks/${taskId}`;
        
        console.log('[Workflow] Claiming task');
        console.log('[Workflow] URL:', url);
        console.log('[Workflow] Body (pool task URI):', body);
        console.log('[Workflow] Body is valid:', !!body && body.includes('/pooltasks/') && !body.includes('undefined'));
        
        const response = await axios.post(url, body, {
            headers: {
                "Content-Type": "text/uri-list",
                "X-XSRF-TOKEN": csrfToken,
                Authorization: authToken,
            },
            withCredentials: true,
        });
        
        console.log('[Workflow] Claim response status:', response.status);
        console.log('[Workflow] Claim response data:', response.data);
        console.log('[Workflow] Claim response headers:', response.headers);
        
        // Handle different response states
        if (response.status === 201 || response.status === 202 || response.status === 204) {
            console.log('[Workflow] Task claimed successfully');
            return { success: true, status: response.status, data: response.data };
        }
        
        return response.data;
    } catch (error: any) {
        const errorStatus = error.response?.status || 500;
        const errorMsg = error.response?.data?.message || error.response?.data || error.message;
        console.error('[Workflow] Claim error:', errorStatus, errorMsg);
        console.error('[Workflow] Full error response:', error.response?.data);
        console.error('[Workflow] Error details - ID was:', id, 'Type:', typeof id);
        
        // 422 - Unprocessable Entity means the pool task ID doesn't exist
        if (errorStatus === 422) {
            console.error('[Workflow] 422 Error - This might not be a valid pool task ID');
            console.error('[Workflow] Check if task ID is in correct format');
            throw new Error(`Invalid pool task ID (${id}). Task may already be claimed or ID format is incorrect.`);
        }
        
        throw new Error(`Failed to claim task: Status ${errorStatus} - ${errorMsg || 'Unknown error'}`);
    }
};

export const approveClaimedTask = async (id: number) => {
    try {
        const url = `${siteConfig.apiEndpoint}/api/workflow/claimedtasks/${id}`;
        const params = new URLSearchParams();
        params.append('submit_approve', 'true');

        console.log('[Workflow] Approving task:', id);
        console.log('[Workflow] URL:', url);
        console.log('[Workflow] Body:', params.toString());
        
        const response = await axios.post(url, params, {
            headers: {
                "Content-Type": "application/x-www-form-urlencoded",
                "X-XSRF-TOKEN": csrfToken,
                Authorization: authToken,
            },
            withCredentials: true,
        });
        
        console.log('[Workflow] Approve response status:', response.status);
        console.log('[Workflow] Approve response data:', response.data);
        
        if (response.status === 201 || response.status === 202 || response.status === 204) {
            console.log('[Workflow] Task approved successfully');
            return { success: true, status: response.status, data: response.data };
        }
        
        return response.data;
    } catch (error: any) {
        const errorStatus = error.response?.status || 500;
        const errorMsg = error.response?.data?.message || error.response?.data || error.message;
        console.error('[Workflow] Approve error:', errorStatus, errorMsg);
        console.error('[Workflow] Full error response:', error.response?.data);
        throw new Error(`Failed to approve task: Status ${errorStatus} - ${errorMsg || 'Unknown error'}`);
    }
};

export const deleteClaimedTask = async (id: number) => {
    try {
